<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/new.css">
    <title>Document</title>
</head>
<body>
    <%- include("navbar.ejs") %>
    <form action="/listings/<%= listing._id %>/edit?_method=PUT" method="POST">
        <h1>Edit Your Listing</h1>
        <p class="form-description">Update the details of your property.</p>
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" value="<%= listing.title %>" required><br><br>

        <label for="description">Description:</label>
        <textarea id="description" name="description" required><%= listing.description %></textarea><br><br>

        <label for="Image">Image URL:</label>
        <input type="text" id="Image" name="Image" value="<%= listing.image.url %>" ><br><br>

        <label for="price">Price:</label>
        <input type="number" id="price" name="price" value="<%= listing.price %>" required><br><br>

        <label for="Location">Location:</label>
        <textarea id="Location" name="Location" required><%= listing.location %></textarea><br><br>


        <label for="Country">Country:</label>
        <input type="text" id="Country" name="Country" value="<%= listing.country %>" required><br><br>

        

        <button type="submit">Update Listing</button>
    </form>
    <br>
    <br>
    <br>
    <br>
    <%- include("footer.ejs") %>
</body>
</html>