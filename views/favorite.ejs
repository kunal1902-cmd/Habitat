
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Favorites | Habitat</title>
   
    <link rel="stylesheet" href="/favorite.css">
</head>
<body>

    <%- include("navbar.ejs") %>

    <main class="favorites-page">
        <header class="favorites-header">
            <span>YOUR COLLECTION</span>
            <h1>My Favorites <span>♡</span></h1>
            <p>Your saved places, all in one place.</p>
        </header>

        <% if (favorites.length === 0) { %>

            <div class="empty-favorites">
                <div class="empty-heart">♡</div>
                <h2>No favorites yet</h2>
                <p>
                    Explore our listings and save the places
                    you'd love to visit.
                </p>
                <a href="/" class="explore-btn">
                    Explore Listings
                </a>
            </div>

        <% } else { %>

            <div class="favorites-grid">
                <% for (const favorite of favorites) { %>
                    <% if (favorite.listing) { %>
                        <article class="favorite-card">

                            <a
                                class="favorite-image-link"
                                href="/listings/<%= favorite.listing._id %>"
                            >
                                <img
                                    src="<%= favorite.listing.image.url %>"
                                    alt="<%= favorite.listing.title %>"
                                >
                            </a>

                            <div class="favorite-content">
                                <h2>
                                    <%= favorite.listing.title %>
                                </h2>
                                

                                <h3>
                                    ₹<%= Number(favorite.listing.price).toLocaleString("en-IN") %>
                                </h3>
                                <p>
                                    <%= favorite.listing.location %>,
                                    <%= favorite.listing.country %>
                                </p>

                                

                                <div class="favorite-actions">
                                    <a
                                        href="/listings/<%= favorite.listing._id %>"
                                        class="view-btn"
                                    >
                                        View Property
                                    </a>

                                    <form
                                        action="/favorite/<%= favorite._id %>/remove?_method=DELETE" method="POST"
                                        method="POST"
                                    >
                                        <button
                                            type="submit"
                                            class="remove-btn"
                                            aria-label="Remove from favorites"
                                        >
                                            ♥ Remove
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </article>
                    <% } %>
                <% } %>
            </div>

        <% } %>
    </main>
    <script src="/favorite.js"></script>

    <%- include("footer.ejs") %>

</body>
</html>
